# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
release/
out/
.vite/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local environment/config
.env
.env.*
!.env.example
*.local

# Per-player data (panoramas, world presets, etc.)
